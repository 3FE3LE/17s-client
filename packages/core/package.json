{
  "name": "@17suit/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./auth/next": {
      "default": "./src/auth/next.tsx"
    },
    "./auth/expo": {
      "default": "./src/auth/expo.tsx"
    },
    "./auth/expo-redirect": {
      "default": "./src/auth/expo-redirect.ts"
    },
    "./site-origins": {
      "default": "./src/site-origins.ts"
    },
    "./query-client": {
      "default": "./src/query-client.ts"
    },
    "./api-types": {
      "default": "./src/api-types.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "gen:api-schema": "openapi-typescript ../../../17s-server/openapi.json -o src/api-schema.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.3",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@clerk/clerk-expo": "^2.19.24",
    "@clerk/nextjs": "^6.30.5",
    "expo-secure-store": "~58.0.3",
    "react": "19.3.0",
    "react-native-safe-area-context": "*"
  },
  "peerDependenciesMeta": {
    "@clerk/clerk-expo": {
      "optional": true
    },
    "@clerk/nextjs": {
      "optional": true
    },
    "expo-secure-store": {
      "optional": true
    },
    "react-native-safe-area-context": {
      "optional": true
    }
  },
  "devDependencies": {
    "@17suit/eslint-config": "workspace:*",
    "@17suit/typescript-config": "workspace:*",
    "@clerk/clerk-expo": "^2.19.24",
    "@clerk/nextjs": "^6.30.5",
    "@types/react": "~19.3.0",
    "@vitest/coverage-v8": "^4.1.9",
    "expo": "~58.0.26",
    "expo-secure-store": "~58.0.3",
    "openapi-typescript": "^7.13.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.9"
  }
}
