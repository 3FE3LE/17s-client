{
  "name": "@17suit/i18n",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./react": {
      "default": "./src/react.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "i18next": "^25.0.0",
    "react-i18next": "^16.0.0"
  },
  "peerDependencies": {
    "react": "19.3.0"
  },
  "devDependencies": {
    "@17suit/eslint-config": "workspace:*",
    "@17suit/typescript-config": "workspace:*",
    "@types/react": "~19.3.0",
    "@vitest/coverage-v8": "^4.1.9",
    "react": "19.3.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.9"
  }
}
