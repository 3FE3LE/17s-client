{
  "extends": "@17suit/typescript-config/nextjs",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "jsx": "react-jsx",
    "types": ["react", "react-dom"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    "paths": {
      "@17suit/design-system": ["../design-system/src"],
      "@17suit/design-system/*": ["../design-system/src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
