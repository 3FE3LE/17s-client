{
  "name": "@17suit/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "react-native": "./src/index.native.ts",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.native.ts",
      "default": "./src/index.ts"
    },
    "./app-providers": {
      "react-native": "./src/app-providers.native.ts",
      "default": "./src/app-providers.ts"
    },
    "./feedback/toast": {
      "react-native": "./src/feedback/toast.native.ts",
      "default": "./src/feedback/toast.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src/index.ts src/index.native.ts src/app-providers.ts src/app-providers.native.ts src/theme.ts src/hooks src/feedback --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@expo-google-fonts/amaranth": "*",
    "@expo-google-fonts/arvo": "*",
    "@expo-google-fonts/zilla-slab": "*",
    "@expo/vector-icons": "*",
    "expo-font": "~14.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": ">=0.81.0 <0.84.0",
    "react-native-safe-area-context": "*",
    "react-native-svg": "15.12.1"
  },
  "peerDependenciesMeta": {
    "@expo/vector-icons": {
      "optional": true
    },
    "@expo-google-fonts/amaranth": {
      "optional": true
    },
    "@expo-google-fonts/arvo": {
      "optional": true
    },
    "@expo-google-fonts/zilla-slab": {
      "optional": true
    },
    "expo-font": {
      "optional": true
    },
    "react-native-safe-area-context": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@17suit/eslint-config": "workspace:*",
    "@17suit/typescript-config": "workspace:*",
    "@expo/vector-icons": "^15.0.3",
    "@types/react": "~19.1.10",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "@17suit/design-system": "workspace:*",
    "@17suit/ui-native": "workspace:*",
    "@17suit/ui-web": "workspace:*",
    "lucide-react": "^0.542.0",
    "lucide-react-native": "^0.542.0"
  }
}
