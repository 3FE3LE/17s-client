{
  "name": "@17suit/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "react-native": "./src/index.native.ts",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.native.ts",
      "default": "./src/index.ts"
    },
    "./app-providers": {
      "react-native": "./src/components/AppProviders/index.native.tsx",
      "default": "./src/app-providers.ts"
    },
    "./tamagui-config": {
      "react-native": "./src/tamagui.config.ts",
      "default": "./src/tamagui.config.ts"
    }
  },
  "scripts": {
    "build": "pnpm run tamagui:build:web && tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "tamagui:build:web": "pnpm exec tamagui generate",
    "tamagui:build:native": "pnpm exec tamagui generate"
  },
  "peerDependencies": {
    "@expo/vector-icons": "*",
    "@expo-google-fonts/amaranth": "*",
    "@expo-google-fonts/arvo": "*",
    "@expo-google-fonts/zilla-slab": "*",
    "@tamagui/config": "2.0.0-rc.14",
    "expo-font": "~14.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": ">=0.81.0 <0.84.0",
    "react-native-safe-area-context": "*",
    "tamagui": "2.0.0-rc.14"
  },
  "peerDependenciesMeta": {
    "@expo/vector-icons": {
      "optional": true
    },
    "@expo-google-fonts/amaranth": {
      "optional": true
    },
    "@expo-google-fonts/arvo": {
      "optional": true
    },
    "@expo-google-fonts/zilla-slab": {
      "optional": true
    },
    "expo-font": {
      "optional": true
    },
    "react-native-safe-area-context": {
      "optional": true
    }
  },
  "devDependencies": {
    "@17suit/eslint-config": "workspace:*",
    "@17suit/typescript-config": "workspace:*",
    "@expo/vector-icons": "^14.1.0",
    "@tamagui/cli": "2.0.0-rc.14",
    "@types/react": "~19.1.10",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "@tamagui/babel-plugin": "2.0.0-rc.14",
    "@tamagui/core": "2.0.0-rc.14",
    "@tamagui/native": "2.0.0-rc.14",
    "@tamagui/next-plugin": "2.0.0-rc.14",
    "lucide-react": "^0.542.0"
  }
}
