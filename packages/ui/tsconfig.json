{
  "extends": "@17suit/typescript-config/node",
  "compilerOptions": {
    "rootDir": "..",
    "outDir": "dist",
    "jsx": "preserve",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["react", "react-native"],
    "paths": {
      "@17suit/design-system": ["../design-system/src"],
      "@17suit/design-system/*": ["../design-system/src/*"]
    },
    "exactOptionalPropertyTypes": false
  },
  "include": [
    "src/index.ts",
    "src/index.native.ts",
    "src/app-providers.ts",
    "src/app-providers.native.ts",
    "src/theme.ts",
    "src/hooks/**/*.ts",
    "src/hooks/**/*.tsx"
  ]
}
