{
  "name": "@17suit/fifteen-ac-mobile",
  "private": true,
  "version": "0.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --port 8083",
    "dev:tunnel": "ANDROID_HOME= ANDROID_SDK_ROOT= expo start --port 8083 --tunnel",
    "build": "expo export --platform all",
    "lint": "eslint . --max-warnings=0",
    "lint:i18n": "eslint -c eslint.i18n.config.cjs .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf .expo dist web-build",
    "build:ios": "eas build --platform ios",
    "build:android": "eas build --platform android",
    "dev:product": "pnpm run dev"
  },
  "dependencies": {
    "@17suit/core": "workspace:*",
    "@17suit/module-fifteen-all-check": "workspace:*",
    "@17suit/ui": "workspace:*",
    "@17suit/ui-native": "workspace:*",
    "@clerk/clerk-expo": "^2.19.24",
    "@expo-google-fonts/amaranth": "latest",
    "@expo-google-fonts/arvo": "latest",
    "@expo-google-fonts/zilla-slab": "latest",
    "@expo/metro-runtime": "~58.0.17",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-picker/picker": "2.11.4",
    "expo": "~58.0.26",
    "expo-auth-session": "~58.0.19",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-font": "~58.0.12",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-web-browser": "~58.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "uniwind": "^1.14.0"
  },
  "devDependencies": {
    "@17suit/eslint-config": "workspace:*",
    "@17suit/tailwind-config": "workspace:*",
    "@17suit/typescript-config": "workspace:*",
    "@sentry/react-native": "~8.28.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/react": "~19.3.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.12",
    "typescript": "~6.0.3"
  }
}
