{
  "expo": {
    "name": "Seven Reservations Club",
    "slug": "seven-rc-mobile",
    "scheme": "seven-rc-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon-17suit.png",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.seventeensuit.sevenrc"
    },
    "android": {
      "package": "com.seventeensuit.sevenrc",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-17suit.png",
        "backgroundColor": "#0B1020"
      }
    },
    "web": {
      "favicon": "./assets/icon-17suit.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1020",
          "image": "./assets/icon-17suit.png",
          "imageWidth": 120
        }
      ]
    ],
    "extra": {
      "sentryDsn": "SENTRY_DSN",
      "sentryEnvironment": "SENTRY_ENVIRONMENT",
      "sentryTracesSampleRate": "SENTRY_TRACES_SAMPLE_RATE"
    }
  }
}
