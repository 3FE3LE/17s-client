# Clerk publishable key (public; inlined into the bundle at build time).
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Optional. Defaults: LAN IP from the Expo host, then 10.0.2.2 (Android emulator), then localhost.
EXPO_PUBLIC_API_BASE_URL=
# Optional, comma-separated extra API base URLs to try.
EXPO_PUBLIC_API_BASE_URL_FALLBACKS=
# Optional Clerk JWT template name for API tokens.
EXPO_PUBLIC_CLERK_JWT_TEMPLATE=
