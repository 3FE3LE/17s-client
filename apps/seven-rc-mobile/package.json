    "@expo-google-fonts/amaranth": "latest",
    "@expo-google-fonts/arvo": "latest",
    "@expo-google-fonts/zilla-slab": "latest",
    "@hookform/resolvers": "^3.10.0",
    "@react-native-picker/picker": "2.11.1",
    "@tamagui/config": "2.0.0-rc.14",
    "@tamagui/core": "2.0.0-rc.14",
    "@tamagui/native": "2.0.0-rc.14",
    "@tamagui/next-plugin": "2.0.0-rc.14",
    "@tanstack/react-query": "^5.90.3",
    "expo": "^54.0.0",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.11",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~14.2.3",
    "expo-web-browser": "~14.2.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.71.2",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-svg": "15.12.1",
