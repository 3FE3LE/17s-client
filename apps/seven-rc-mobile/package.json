{
  "name": "@17suit/seven-rc-mobile",
  "private": true,
  "version": "0.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "expo start --port 8087",
    "dev:tunnel": "ANDROID_HOME= ANDROID_SDK_ROOT= expo start --port 8087 --tunnel",
    "build": "expo export --platform all",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf .expo dist web-build",
    "build:ios": "eas build --platform ios",
    "build:android": "eas build --platform android",
    "dev:product": "pnpm run dev",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@17suit/core": "workspace:*",
    "@17suit/module-seven-reservations-club": "workspace:*",
    "@17suit/ui": "workspace:*",
    "@clerk/clerk-expo": "^2.19.24",
    "@expo-google-fonts/amaranth": "latest",
    "@expo-google-fonts/arvo": "latest",
    "@expo-google-fonts/zilla-slab": "latest",
    "@expo/vector-icons": "^15.0.3",
    "@hookform/resolvers": "^3.10.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-picker/picker": "2.11.1",
    "@tanstack/react-query": "^5.90.3",
    "expo": "^54.0.0",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~14.2.3",
    "expo-web-browser": "~14.2.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.71.2",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.5.1",
    "uniwind": "^1.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@17suit/eslint-config": "workspace:*",
    "@17suit/tailwind-config": "workspace:*",
    "@17suit/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/react": "~19.1.10",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.8.2"
  }
