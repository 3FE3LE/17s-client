{
  "name": "@17suit/landing",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "next dev --turbopack --port 3000",
    "dev:product": "pnpm run dev",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "clean": "rm -rf .next"
  },
  "dependencies": {
    "@17suit/core": "workspace:*",
    "@17suit/ui": "workspace:*",
    "@clerk/nextjs": "^6.30.5",
    "next": "^16.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@17suit/eslint-config": "workspace:*",
    "@17suit/tailwind-config": "workspace:*",
    "@17suit/typescript-config": "workspace:*",
    "@playwright/test": "1.61.1",
    "@sentry/nextjs": "10.62.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/node": "^24.12.2",
    "@types/react": "~19.1.10",
    "@types/react-dom": "~19.1.7",
    "@vitest/coverage-v8": "^4.1.9",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.8.2",
    "vitest": "^4.1.9"
  }
}
