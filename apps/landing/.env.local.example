# Landing acts as the central Clerk auth hub. After sign-in it redirects back to
# the product app that initiated the flow (via ?redirect_url=...).
#
# Product origins come from @17suit/core/site-origins (no env var needed). In
# development, localhost/127.0.0.1 origins are auto-allowed.

# Optional comma-separated extra origins (e.g. preview deployments only)
# NEXT_PUBLIC_ALLOWED_REDIRECT_ORIGINS=https://app.example.com,https://other.example.com

# Clerk (publishable/secret keys for the shared dev instance)
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=

# Public contact address shown on /contact (mailto link). Unset = the page shows
# "Contact channel being set up" and no link. Do not hard-code it in code.
# NEXT_PUBLIC_CONTACT_EMAIL=

# Public origin used for canonical URLs, hreflang alternates and the sitemap.
# Defaults to https://17suit.com when unset. Set it on preview/staging deploys.
# NEXT_PUBLIC_SITE_URL=http://localhost:3010
