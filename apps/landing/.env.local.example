# Landing acts as the central Clerk auth hub. After sign-in it redirects back to
# the product app that initiated the flow (via ?redirect_url=...).
#
# In development, localhost/127.0.0.1 origins are auto-allowed, so these are
# optional locally. In production they MUST be set so cross-origin redirects to
# the product apps are allow-listed (otherwise the redirect falls back to "/").

# Product app origins (used to validate redirect_url)
NEXT_PUBLIC_FIFTEEN_AC_WEB_URL=http://localhost:3015
NEXT_PUBLIC_SEVEN_RC_WEB_URL=http://localhost:3007
# Optional comma-separated extra origins
# NEXT_PUBLIC_ALLOWED_REDIRECT_ORIGINS=https://app.example.com,https://other.example.com

# Clerk (publishable/secret keys for the shared dev instance)
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
