{
  "name": "@17suit/seven-rc-web",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "next dev --turbopack --port 3007",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:i18n": "eslint -c eslint.i18n.config.cjs .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf .next",
    "dev:product": "pnpm run dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:real": "playwright test --config playwright.real.config.ts"
  },
  "dependencies": {
    "@17suit/core": "workspace:*",
    "@17suit/i18n": "workspace:*",
    "@17suit/module-seven-reservations-club": "workspace:*",
    "@17suit/ui": "workspace:*",
    "@clerk/nextjs": "^6.30.5",
    "@tanstack/react-query": "^5.90.3",
    "next": "^16.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@17suit/eslint-config": "workspace:*",
    "@17suit/tailwind-config": "workspace:*",
    "@17suit/typescript-config": "workspace:*",
    "@playwright/test": "1.61.1",
    "@sentry/nextjs": "10.62.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24.12.2",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@vitest/coverage-v8": "^4.1.9",
    "jsdom": "^31.0.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.12",
    "typescript": "~6.0.3",
    "vitest": "^4.1.9"
  }
}
