# Copy to .env.local. Never commit real values.
# Clerk (same instance as landing and the product apps).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Shared sign-in lives on landing; the /sign-in bridge forwards there with redirect_url.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=http://localhost:3000/sign-in
# Operator allowlist (server-only, never prefix with NEXT_PUBLIC_). Comma-separated,
# case-insensitive, matched against the user's verified Clerk emails.
# Unset or empty = nobody can enter the console (deny by default).
ADMIN_ALLOWED_EMAILS=
# Optional, server-only: who to ask for console access, shown on the 403 page.
# An email renders as a mailto link; any other text renders as-is. Unset = generic line.
ADMIN_ACCESS_CONTACT=
